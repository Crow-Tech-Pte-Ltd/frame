# /etc/systemd/system/frame.service — Frame photo-sharing server.
#
# Installed by deploy/install.sh. Configuration: /etc/frame/frame.conf
# (root-owned 0600; systemd reads it as root before dropping privileges).
# Data: /var/lib/frame (a symlink to /var/lib/private/frame, owned by the
# service's dynamic user). Admin commands: `sudo frame-admin …`.
#
# Do not edit this file: it is replaced on upgrade. Put local changes in a
# drop-in instead:  sudo systemctl edit frame
#
# Built-in HTTPS (FRAME_DOMAIN) needs to bind ports 80/443. install.sh then adds
# /etc/systemd/system/frame.service.d/10-https.conf containing:
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Without FRAME_DOMAIN the service runs with no capabilities at all.

[Unit]
Description=Frame photo-sharing server
Documentation=https://github.com/Crow-Tech-Pte-Ltd/frame/blob/main/docs/SELF-HOSTING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/frame/frame.conf
ExecStart=/usr/local/bin/frame-server serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# Identity & state: a throwaway system user that exists only while the
# service runs; it can write nowhere except its state directory.
DynamicUser=yes
User=frame
Group=frame
StateDirectory=frame
StateDirectoryMode=0700
Environment=FRAME_DATA_DIR=/var/lib/frame
WorkingDirectory=/var/lib/frame
UMask=0077

# Privileges.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes

# Kernel attack surface.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed

# Resources.
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=multi-user.target
